# NOPA Dashboard (PWA) untuk hosting Apache/LiteSpeed (mis. Hostinger).
# Diabaikan oleh GitHub Pages.

# Paksa HTTPS (PWA & service worker wajib HTTPS)
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Tipe file
AddType application/manifest+json .webmanifest
AddType text/javascript .js

# Jangan cache file yang menentukan versi aplikasi, agar pembaruan langsung sampai
<FilesMatch "^(sw\.js|index\.html|manifest\.webmanifest)$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>
# File lain diberi nomor versi (?v=N), aman disimpan lama
<FilesMatch "\.(css|js|png)$">
  Header set Cache-Control "public, max-age=604800"
</FilesMatch>
<FilesMatch "^sw\.js$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Service-Worker-Allowed "/"
</FilesMatch>

# Keamanan dasar
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "DENY"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Options -Indexes
